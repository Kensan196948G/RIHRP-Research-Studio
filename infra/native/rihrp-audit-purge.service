[Unit]
Description=RIHRP audit log retention purge (destructive; enable only after approval)
Documentation=file:///home/kensan/Projects/Business-Project/RIHRP-Research-Studio/docs/adr/0006-audit-retention.md

[Service]
Type=oneshot
UMask=0077
WorkingDirectory=%h/Projects/Business-Project/RIHRP-Research-Studio
EnvironmentFile=%h/.config/rihrp/rihrp.conf
Environment=RIHRP_ALLOW_AUDIT_PURGE=1
ExecStart=%h/Projects/Business-Project/RIHRP-Research-Studio/.venv/bin/python -m rihrp.maintenance purge-audit --days 365 --commit
Nice=10
