# RIHRP Research Studio — 環境変数（値は実環境で設定し、コミットしない）

# 実行環境: development | test | production
RIHRP_ENV=development

# PostgreSQL（ローカル）
RIHRP_DATABASE_URL=postgresql+psycopg://rihrp_app:CHANGE_ME@127.0.0.1:5432/rihrp

# セッション Cookie の Secure 属性（production では true）
RIHRP_COOKIE_SECURE=false
# セッション有効期限（分）
RIHRP_SESSION_TTL_MINUTES=480

# 初回起動時のデモユーザー投入（development/test のみ。production では false）
RIHRP_SEED_DEMO=true

# ログイン試行のレート制限（回/分/IP）
RIHRP_LOGIN_RATE_LIMIT=10

# Cloudflare Access 連携（production のみ true。ヘッダー信頼は Access 経由の同一ホストに限定）
RIHRP_TRUST_CF_ACCESS=false

# 監査ログ保持（日）
RIHRP_AUDIT_RETENTION_DAYS=365
