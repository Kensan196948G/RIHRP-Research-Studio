# RIHRP Research Studio — 環境変数（値は実環境で設定し、コミットしない）

# 実行環境: development | test | production
RIHRP_ENV=development

# PostgreSQL（ローカル）
RIHRP_DATABASE_URL=postgresql+psycopg://rihrp_app:CHANGE_ME@127.0.0.1:5432/rihrp

# セッション Cookie の Secure 属性（production では true）
RIHRP_COOKIE_SECURE=false
# セッション有効期限（分）
RIHRP_SESSION_TTL_MINUTES=480

# 初回起動時のデモユーザー投入（development/test のみ。production では false）
RIHRP_SEED_DEMO=true

# ログイン試行のレート制限（回/分/IP）
RIHRP_LOGIN_RATE_LIMIT=10

# Cloudflare Access 連携（production のみ true）。
# true のとき /api/auth/access が Cf-Access-Jwt-Assertion を検証して自動ログインする。
RIHRP_TRUST_CF_ACCESS=false
# Access の team domain（例: winter-lake-f4c9.cloudflareaccess.com）
RIHRP_CF_ACCESS_TEAM_DOMAIN=
# Access アプリケーションの AUD タグ
RIHRP_CF_ACCESS_AUD=
# 自動ログインを許可する email（カンマ区切り）。空なら全拒否。
RIHRP_CF_ACCESS_ALLOWED_EMAILS=
# ループバック接続だけを許可する追加防御（既定 false）。
# uvicorn は proxy headers を既定で信頼するため、Tunnel 経由では client host が実 IP になる。
# 有効にするのは uvicorn を --no-proxy-headers で動かす場合だけ。
RIHRP_CF_ACCESS_LOOPBACK_ONLY=false
# 未登録ユーザーの自動作成（既定 false）と既定ロール
RIHRP_CF_ACCESS_PROVISION=false
RIHRP_CF_ACCESS_DEFAULT_ROLE=viewer

# 監査ログ保持（日）
RIHRP_AUDIT_RETENTION_DAYS=365

# AI 下書き（ADR-0006）。未設定なら機能だけ 503 で無効。鍵はコミットしない。
RIHRP_LLM_PROVIDER=openai
RIHRP_LLM_BASE_URL=
RIHRP_LLM_MODEL=
RIHRP_LLM_API_KEY=
RIHRP_LLM_TIMEOUT_SECONDS=30
RIHRP_LLM_MAX_CLAIMS=8
RIHRP_LLM_MAX_SOURCE_CHARS=12000
RIHRP_LLM_RATE_LIMIT=5
